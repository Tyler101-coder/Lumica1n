<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0//EN">

<plist version="1.0">
<dict>

    <key>PayloadContent</key>
    <array>

        <dict>
            <key>PayloadType</key>
            <string>com.apple.mobiledevice.passwordpolicy</string>

            <key>PayloadVersion</key>
            <integer>1</integer>

            <key>PayloadIdentifier</key>
            <string>com.lumica1n.security.passcode</string>

            <key>PayloadUUID</key>
            <string>18AAF0BF-50BE-4E6C-9189-DACABB6CC07B</string>

            <key>PayloadDisplayName</key>
            <string>Lumica1n Maximum Passcode Security</string>

            <key>PayloadDescription</key>
            <string>
                Strong passcode requirements for supported Apple devices.
            </string>

            <key>PayloadOrganization</key>
            <string>Lumica1n</string>

            <!-- Minimum 20-character passcode -->
            <key>minLength</key>
            <integer>20</integer>

            <!-- Require letters and numbers -->
            <key>requireAlphanumeric</key>
            <true/>

            <!-- At least 2 non-alphanumeric characters -->
            <key>minComplexChars</key>
            <integer>2</integer>

            <!-- Remember the previous 10 passcodes -->
            <key>pinHistory</key>
            <integer>10</integer>

            <!-- Lock policy after repeated failures -->
            <key>maxFailedAttempts</key>
            <integer>10</integer>

            <!-- Require authentication rather than allowing a grace period -->
            <key>maxGracePeriod</key>
            <integer>0</integer>
        </dict>

    </array>

    <key>PayloadType</key>
    <string>Configuration</string>

    <key>PayloadVersion</key>
    <integer>1</integer>

    <key>PayloadIdentifier</key>
    <string>com.lumica1n.security</string>

    <key>PayloadUUID</key>
    <string>A8240587-DF3D-40BE-ABC9-E6DDCB6CFCFE</string>

    <key>PayloadDisplayName</key>
    <string>Lumica1n Security</string>

    <key>PayloadDescription</key>
    <string>
        Lumica1n security hardening profile.
    </string>

    <key>PayloadOrganization</key>
    <string>Lumica1n</string>

    <key>PayloadRemovalDisallowed</key>
    <false/>

</dict>
</plist>
